    <string>/bin/bash</string>
    <string>/Users/suleymansercemgulmez/Projeler/llm_test_lab/scripts/free_phase_tick.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>WorkingDirectory</key>
  <string>/Users/suleymansercemgulmez/Projeler/llm_test_lab</string>
  <key>StandardOutPath</key>
  <string>/Users/suleymansercemgulmez/Projeler/llm_test_lab/outputs/.progress/launchd_test.log</string>
