{
"openapi": "3.0.3",
"info": {"title": "Httpbin Five Operations", "version": "1.0.0"},
"servers": [{"url": "https://httpbin.org"}],
"paths": {
"/status/{code}": {"get": {"summary": "Returns the requested status code",
"parameters": [{"name": "code", "in": "path", "required": true, "schema": {"type": "integer", "enum": [200, 400, 404, 500]}}],
"responses": {"200": {"description": "OK, empty body"}, "400": {"description": "Bad Request, empty body"}, "404": {"description": "Not Found, empty body"}, "500": {"description": "Internal Server Error, empty body"}}}},
"/get": {"get": {"summary": "Echoes query parameters",
"parameters": [{"name": "q", "in": "query", "required": false, "schema": {"type": "string"}, "example": "smoke"}],
"responses": {"200": {"description": "JSON echo", "content": {"application/json": {"schema": {"type": "object"}}}}}}},
"/anything": {"post": {"summary": "Echoes JSON body",
"requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string"}}}, "example": {"message": "smoke"}}}},
"responses": {"200": {"description": "JSON echo", "content": {"application/json": {"schema": {"type": "object"}}}}}}},
"/headers": {"get": {"summary": "Returns request headers",
"responses": {"200": {"description": "JSON headers", "content": {"application/json": {"schema": {"type": "object"}}}}}}},
"/uuid": {"get": {"summary": "Returns a UUID",
"responses": {"200": {"description": "JSON uuid", "content": {"application/json": {"schema": {"type": "object"}}}}}}}
}
}
